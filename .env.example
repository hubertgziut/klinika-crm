# Klinika CRM — konfiguracja środowiska (skopiuj do .env i uzupełnij)
PORT=3000
HOST=0.0.0.0
# Konto administratora tworzone przy pierwszym uruchomieniu
ADMIN_EMAIL=admin@klinika.local
ADMIN_PASSWORD=ZmieńMnie123!
SESSION_SECRET=zmien-na-dlugo-losowy-ciag-znakow
# SMTP — opcjonalnie; można ustawić też w panelu Ustawienia
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Klinika CRM <noreply@klinika.local>
# AI — dostawca: auto | openai | deepseek (auto: DeepSeek > OpenAI)
AI_PROVIDER=auto
# OpenAI — opcjonalnie (bez klucza AI działa w trybie demo)
OPENAI_API_KEY=
# DeepSeek — opcjonalnie (OpenAI-kompatybilne API, np. model deepseek-v4-flash)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Opcjonalne wyszukiwanie produktów w sieci (np. Brave Search API)
SEARCH_API_KEY=
